    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const err = $input.item.json;\n\n// Google API errors usually arrive nested like err.error.errors[0].reason / message,\n// or sometimes flattened depending on how the HTTP Request node surfaced it.\nconst googleError = err.error?.errors?.[0] || err.error || err;\nconst rawMessage = (googleError.message || err.message || '').toLowerCase();\nconst statusCode = err.error?.code || err.statusCode || err.code || null;\n\nlet category = 'unknown_error';\nlet userMessage = 'An unexpected error occurred while creating the event.';\n\nif (statusCode === 401 || rawMessage.includes('invalid credentials') || rawMessage.includes('unauthorized')) {\n  category = 'auth_error';\n  userMessage = 'Authentication failed - the calendar access token may be invalid or expired.';\n} else if (statusCode === 403) {\n  category = 'permission_error';\n  userMessage = 'Permission denied - check that the calendar scope/consent is granted.';\n} else if (rawMessage.includes('date') || rawMessage.includes('datetime') || rawMessage.includes('invalid time')) {\n  category = 'invalid_date';\n  userMessage = 'The start or end date/time format is invalid.';\n} else if (rawMessage.includes('required') || rawMessage.includes('missing')) {\n  category = 'missing_field';\n  userMessage = 'One or more required fields (summary, start, end) are missing.';\n} else if (statusCode === 400 || rawMessage.includes('bad request')) {\n  category = 'bad_request';\n  userMessage = 'The request was malformed - please check all field values.';\n}\n\nreturn {\n  status: 'error',\n  category,\n  message: userMessage,\n  rawError: rawMessage || null\n};"
      },
