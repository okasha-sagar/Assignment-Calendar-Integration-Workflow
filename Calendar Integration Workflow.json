    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n\n  const err = item.json.error;\n\n  // Default values (success case)\n  let status = item.json.statusCode;\n  let message = \"Unknown error\";\n  let rawError = null;\n\n  if (err) {\n    status = err.status || status;\n\n    // Parse the Axios error message\n    try {\n      const jsonString = err.message.replace(/^\\d+\\s*-\\s*/, \"\");\n      rawError = JSON.parse(jsonString).error;\n      message = rawError.message;\n    } catch {\n      message = err.message;\n      rawError = err;\n    }\n  }\n\n  let category;\n\n  if (status >= 500) {\n    category = \"Server Error\";\n  } else if (status === 401) {\n    category = \"Unauthorized\";\n  } else if (status === 403) {\n    category = \"Forbidden\";\n  } else if (status === 400) {\n    category = \"Bad Request\";\n  } else if (status >= 400) {\n    category = \"Client Error\";\n  } else {\n    category = \"Unknown\";\n  }\n\n  return {\n    json: {\n      success: false,\n      statusCode: status,\n      category,\n      message,\n      rawError\n    }\n  };\n});"
      },
