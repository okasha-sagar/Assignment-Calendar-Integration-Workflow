    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nfunction error(message) {\n  return {\n    json: {\n      success: false,\n      status: \"error\",\n      statusCode: 400,\n      category: \"bad_request\",\n      message\n    }\n  };\n}\n\nif (!item.summary)\n  return error(\"summary is required\");\n\nif (!item.start?.dateTime)\n  return error(\"start.dateTime is required\");\n\nif (!item.end?.dateTime)\n  return error(\"end.dateTime is required\");\n\nif (!item.start?.timeZone)\n  return error(\"start.timeZone is required\");\n\nif (!item.end?.timeZone)\n  return error(\"end.timeZone is required\");\n\nif (isNaN(Date.parse(item.start.dateTime)))\n  return error(\"Invalid start.dateTime\");\n\nif (isNaN(Date.parse(item.end.dateTime)))\n  return error(\"Invalid end.dateTime\");\n\nif (new Date(item.start.dateTime) >= new Date(item.end.dateTime))\n  return error(\"Start must be before End\");\n\nreturn {\n  json: {\n    success: true,\n    statusCode: 200,\n    data: item\n  }\n};"
      },
